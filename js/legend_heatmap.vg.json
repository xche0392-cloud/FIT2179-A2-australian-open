{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Legend Stats Comparison at Australian Open", "color": "#ffffff", "fontSize": 16},
  "width": 400,
  "height": 350,
  "background": "#0f2040",
  "data": {"url": "data/legends_stats.csv"},
  "mark": {"type": "rect"},
  "encoding": {
    "x": {"field": "stat", "type": "nominal", "title": null, "axis": {"labelColor": "#ccddff", "labelAngle": 0}},
    "y": {"field": "player", "type": "nominal", "title": null, "axis": {"labelColor": "#ccddff"}},
    "color": {"field": "value", "type": "quantitative", "scale": {"scheme": "blues", "domain": [0, 1]}, "legend": {"labelColor": "#ccddff", "titleColor": "#ccddff", "title": "Score"}},
    "tooltip": [
      {"field": "player", "title": "Player"},
      {"field": "stat", "title": "Stat"},
      {"field": "value", "title": "Score", "format": ".2f"}
    ]
  }
}
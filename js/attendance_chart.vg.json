{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Australian Open Annual Attendance (2000–2026)", "color": "#ffffff", "fontSize": 16},
  "width": 400,
  "height": 350,
  "background": "#0f2040",
  "data": {"url": "data/attendance.csv"},
  "params": [
    {
      "name": "year_from",
      "value": 2000,
      "bind": {
        "input": "select",
        "options": [2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025],
        "name": "From: "
      }
    },
    {
      "name": "year_to",
      "value": 2026,
      "bind": {
        "input": "select",
        "options": [2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026],
        "name": "To: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.year >= year_from && datum.year <= year_to"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#ff6b6b", "strokeDash": [4, 4], "opacity": 0.8},
      "encoding": {
        "x": {"datum": "2020", "type": "ordinal"}
      }
    },
    {
      "mark": {"type": "text", "color": "#ff6b6b", "align": "right", "dx": -5, "dy": -120, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2020", "type": "ordinal"},
        "text": {"value": "COVID-19"}
      }
    },
    {
      "mark": {"type": "line", "point": true, "color": "#a0c4ff"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "labelAngle": -45}},
        "y": {"field": "attendance", "type": "quantitative", "title": "Total Attendance", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "format": "~f"}},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "attendance", "type": "quantitative", "title": "Attendance", "format": ","}
        ]
      }
    },
    {
      "data": {"values": [{"year": "2026", "attendance": 1370000}]},
      "mark": {"type": "point", "shape": "arrow", "color": "#4ade80", "size": 200, "angle": 180},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "attendance", "type": "quantitative"}
      }
    },
    {
      "data": {"values": [{"year": "2026", "attendance": 1370000}]},
      "mark": {"type": "text", "color": "#4ade80", "align": "right", "dx": -8, "dy": -15, "fontSize": 11, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "attendance", "type": "quantitative"},
        "text": {"value": "Record: 1.37M"}
      }
    },
    {
      "data": {"values": [{"year": "2021", "attendance": 130000}]},
      "mark": {"type": "text", "color": "#ff6b6b", "align": "left", "dx": 5, "dy": 15, "fontSize": 10},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "attendance", "type": "quantitative"},
        "text": {"value": "↓ 84% drop"}
      }
    }
  ]
}
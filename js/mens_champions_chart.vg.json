{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Men's Australian Open Champions (2000–2026)", "color": "#ffffff", "fontSize": 16},
  "width": 600,
  "height": 300,
  "background": "#0f2040",
  "data": {"url": "data/mens_grand_slam.csv"},
  "transform": [
    {"filter": "datum.TOURNAMENT === 'Australian Open'"},
    {"filter": "datum.YEAR >= 2000"}
  ],
  "params": [
    {
      "name": "country_select",
      "bind": {
        "input": "select",
        "options": [null, "Serbian", "Swiss", "Spanish", "American", "Russian", "Swedish"],
        "labels": ["All Countries", "Serbia", "Switzerland", "Spain", "USA", "Russia", "Sweden"],
        "name": "Filter by Country: "
      }
    }
  ],
  "mark": {"type": "point", "filled": true, "size": 150},
  "encoding": {
    "x": {"field": "YEAR", "type": "ordinal", "title": "Year", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "labelAngle": -45}},
    "y": {"field": "WINNER", "type": "nominal", "title": null, "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
    "color": {"field": "WINNER_NATIONALITY", "type": "nominal", "title": "Country", "legend": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
    "opacity": {
      "condition": {"test": "!country_select || datum.WINNER_NATIONALITY === country_select", "value": 1},
      "value": 0.1
    },
    "tooltip": [
      {"field": "YEAR", "title": "Year"},
      {"field": "WINNER", "title": "Champion"},
      {"field": "WINNER_NATIONALITY", "title": "Country"}
    ]
  }
}
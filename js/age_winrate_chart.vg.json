{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Champion's Ranking vs Prize Money at Australian Open", "color": "#ffffff", "fontSize": 16},
  "width": 400,
  "height": 350,
  "background": "#0f2040",
  "data": {"url": "data/mens_grand_slam.csv"},
  "transform": [
    {"filter": "datum.TOURNAMENT === 'Australian Open'"},
    {"filter": "datum.YEAR >= 2000"},
    {"filter": "datum.WINNER_ATP_RANKING != ''"}
  ],
  "mark": {"type": "point", "filled": true, "size": 100},
  "encoding": {
    "x": {"field": "WINNER_ATP_RANKING", "type": "quantitative", "title": "Champion's ATP Ranking", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
    "y": {"field": "WINNER_PRIZE", "type": "quantitative", "title": "Prize Money (USD)", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "format": "$,.0f"}},
    "color": {"field": "WINNER_NATIONALITY", "type": "nominal", "title": "Country", "legend": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
    "tooltip": [
      {"field": "YEAR", "title": "Year"},
      {"field": "WINNER", "title": "Champion"},
      {"field": "WINNER_ATP_RANKING", "title": "Ranking"},
      {"field": "WINNER_PRIZE", "title": "Prize Money", "format": "$,.0f"}
    ]
  }
}
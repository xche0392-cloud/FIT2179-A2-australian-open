{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Australian Open Winner's Prize Money (2000–2026)", "color": "#ffffff", "fontSize": 16},
  "width": 400,
  "height": 350,
  "background": "#0f2040",
  "data": {"url": "data/mens_grand_slam.csv"},
  "params": [
    {
      "name": "year_from",
      "value": 2000,
      "bind": {
        "input": "range",
        "min": 2000,
        "max": 2024,
        "step": 1,
        "name": "From: "
      }
    },
    {
      "name": "year_to",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2025,
        "step": 1,
        "name": "To: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.TOURNAMENT === 'Australian Open'"},
    {"filter": "datum.YEAR >= year_from && datum.YEAR <= year_to"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#ff6b6b", "strokeDash": [4, 4], "opacity": 0.8},
      "encoding": {
        "x": {"datum": "2021", "type": "ordinal"}
      }
    },
    {
      "mark": {"type": "text", "color": "#ff6b6b", "align": "right", "dx": -5, "dy": -120, "fontSize": 11},
      "encoding": {
        "x": {"datum": "2021", "type": "ordinal"},
        "text": {"value": "COVID-19 impact"}
      }
    },
    {
      "mark": {"type": "line", "point": true, "color": "#a0c4ff"},
      "encoding": {
        "x": {"field": "YEAR", "type": "ordinal", "title": "Year", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "labelAngle": -45}},
        "y": {"field": "WINNER_PRIZE", "type": "quantitative", "title": "Prize Money (USD)", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff", "format": "$,.0f"}},
        "tooltip": [
          {"field": "YEAR", "title": "Year"},
          {"field": "WINNER", "title": "Champion"},
          {"field": "WINNER_PRIZE", "title": "Prize Money", "format": "$,.0f"}
        ]
      }
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#0f2040",
  "vconcat": [
    {
      "title": {"text": "Player Nationalities at Australian Open 2026", "color": "#ffffff", "fontSize": 16},
      "width": 800,
      "height": 400,
      "params": [
        {
          "name": "zoom",
          "value": 153,
          "bind": {
            "input": "range",
            "min": 100,
            "max": 600,
            "step": 10,
            "name": "Zoom Level: "
          }
        },
        {
          "name": "center_lon",
          "value": 134,
          "bind": {
            "input": "range",
            "min": -180,
            "max": 180,
            "step": 5,
            "name": "Pan Horizontally (Longitude): "
          }
        },
        {
          "name": "center_lat",
          "value": -25,
          "bind": {
            "input": "range",
            "min": -90,
            "max": 90,
            "step": 5,
            "name": "Pan Vertically (Latitude): "
          }
        },
        {
          "name": "country_highlight",
          "select": {"type": "point", "fields": ["country"]}
        }
      ],
      "projection": {
        "type": "equalEarth",
        "rotate": {"expr": "[-center_lon, -center_lat, 0]"},
        "scale": {"expr": "zoom"}
      },
      "layer": [
        {
          "data": {
            "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
          },
          "mark": {"type": "geoshape", "fill": "#1a3a5c", "stroke": "#ffffff", "strokeWidth": 0.5}
        },
        {
          "data": {"url": "data/ao2026.csv"},
          "transform": [
            {"fold": ["player_1_country", "player_2_country"], "as": ["side", "country"]},
            {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["country"]},
            {
              "lookup": "country",
              "from": {
                "data": {
                  "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
                  "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                },
                "key": "properties.ISO_A2",
                "fields": ["properties.NAME", "type", "geometry"]
              }
            }
          ],
          "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.5},
          "encoding": {
            "shape": {"field": "geometry", "type": "geojson"},
            "color": {
              "field": "count",
              "type": "quantitative",
              "title": "Player Count",
              "scale": {"scheme": "blues", "type": "log"},
              "legend": {"labelColor": "#ccddff", "titleColor": "#ccddff"}
            },
            "opacity": {
              "condition": {"param": "country_highlight", "value": 1},
              "value": 0.3
            },
            "tooltip": [
              {"field": "properties.NAME", "title": "Country"},
              {"field": "count", "title": "Players"}
            ]
          }
        }
      ]
    },
    {
      "title": {"text": "Top 10 Nations by Player Count (AO 2026)", "color": "#ffffff", "fontSize": 16},
      "width": 800,
      "height": 300,
      "data": {"url": "data/ao2026.csv"},
      "transform": [
        {"fold": ["player_1_country", "player_2_country"], "as": ["side", "country"]},
        {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["country"]},
        {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "count", "order": "descending"}]},
        {"filter": "datum.rank <= 10"}
      ],
      "mark": {"type": "bar"},
      "encoding": {
        "x": {"field": "count", "type": "quantitative", "title": "Number of Appearances", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
        "y": {"field": "country", "type": "nominal", "title": null, "sort": "-x", "axis": {"labelColor": "#ccddff", "titleColor": "#ccddff"}},
        "color": {
          "condition": {"param": "country_highlight", "value": "#a0c4ff"},
          "value": "#1a3a5c"
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "count", "title": "Appearances"}
        ]
      }
    }
  ]
}